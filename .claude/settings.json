{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(git status)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(yamllint:*)",
      "Bash(bash -n:*)",
      "Bash(shellcheck:*)",
      "Bash(kubectl get:*)",
      "Bash(kubectl describe:*)",
      "Bash(kubectl logs:*)",
      "Bash(kubectl top:*)",
      "Bash(helm template:*)",
      "Bash(helm show:*)"
    ],
    "ask": [
      "Bash(kubectl apply:*)",
      "Bash(kubectl delete:*)",
      "Bash(kubectl edit:*)",
      "Bash(kubectl exec:*)",
      "Bash(helm install:*)",
      "Bash(helm upgrade:*)",
      "Bash(helm uninstall:*)",
      "Bash(ssh:*)",
      "Bash(scp:*)",
      "Bash(git push:*)"
    ],
    "deny": [
      "Bash(kubectl get secret:*)",
      "Bash(kubectl get secrets:*)",
      "Read(./**/cluster-token)",
      "Read(./**/agent-token)",
      "Read(./**/*.kubeconfig)",
      "Read(./**/rke2.yaml)",
      "Read(./**/.env)",
      "Read(~/.kube/**)"
    ]
  }
}
