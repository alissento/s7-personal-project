# Managed by Ansible (roles/rke2). Manual changes are overwritten.
# Overrides for the Cilium chart bundled with RKE2. It must be in place before the first start,
# so Cilium is installed with these values from day one.
---
apiVersion: helm.cattle.io/v1
kind: HelmChartConfig
metadata:
  name: rke2-cilium
  namespace: kube-system
spec:
  valuesContent: |-
    # kube-proxy is disabled in the server config. Cilium handles Services with eBPF instead.
    kubeProxyReplacement: true
    # Reach the API server through the node-local endpoint (as in the RKE2 docs), NOT the VIP:
    # kube-vip itself needs a working CNI before the VIP exists, so pointing Cilium at the VIP
    # would deadlock the first boot.
    k8sServiceHost: "localhost"
    k8sServicePort: "6443"

    # Take pod IPs from cluster-cidr (one /24 per node). Explicit on purpose:
    # Cilium's own default pool is 10.0.0.0/8, which would overlap the node network.
    ipam:
      mode: kubernetes

    # The masters carry CriticalAddonsOnly=true:NoExecute (server config), and the operator's default
    # tolerations in rke2-cilium 1.20.200 don't include it. Without the operator, the agent waits forever
    # for its CRDs and never gets ready. Setting tolerations replaces the chart's list, so the defaults
    # are repeated here with CriticalAddonsOnly added.
    operator:
      tolerations:
        - key: CriticalAddonsOnly
          operator: Exists
        - key: node-role.kubernetes.io/control-plane
          operator: Exists
        - key: node-role.kubernetes.io/etcd
          operator: Exists
        - key: node-role.kubernetes.io/master
          operator: Exists
        - key: node.cilium.io/agent-not-ready
          operator: Exists
        - key: node.cloudprovider.kubernetes.io/uninitialized
          operator: Exists
        - key: node.kubernetes.io/not-ready
          operator: Exists
        - key: node.kubernetes.io/unreachable
          operator: Exists
          effect: NoExecute
          tolerationSeconds: 300

    # Must be unique per cluster for a possible Cluster Mesh with EduCloud. Set now: changing them later
    # means restarting every pod.
    cluster:
      name: {{ cilium_cluster_name }}
      id: {{ cilium_cluster_id }}

    # Flow visibility: who talked to whom, and what was dropped by policy.
    hubble:
      enabled: true
      relay:
        enabled: true
      ui:
        enabled: true
